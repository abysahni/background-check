# Copy to .streamlit/secrets.toml and fill in. NEVER commit the real file.
#
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# Locally this file is OPTIONAL (the app falls back to .env / env vars).
# On Streamlit Community Cloud paste these into the Secrets editor.

GEMINI_API_KEY = "your_gemini_api_key_here"   # https://aistudio.google.com/
STORE_ACCESS_CODE = "change-me-to-a-long-passphrase"
STORE_NAME = "Your Store Name"

# Optional: paid Google search via serper.dev (far more reliable and faster than
# the free DuckDuckGo path). Recommended for real use.
# SERPER_API_KEY = "your_serper_key"

# Optional: "true" auto-accepts 'likely'-tier corroborated profile photos without
# human confirmation. Leave false unless you accept that a mis-attributed photo
# could enter a hiring file unreviewed.
PHOTO_AUTO_ACCEPT_LIKELY = "false"
